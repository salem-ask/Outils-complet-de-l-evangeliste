# Réglages Hostinger (LiteSpeed / Apache) pour la page de vente

# Cacher les fichiers Git et le README aux visiteurs
RedirectMatch 404 /\.git
RedirectMatch 404 /README\.md$

# Servir les formats d'image et de police modernes avec le bon type
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2

# Compresser la page avant de l'envoyer
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css image/svg+xml
</IfModule>

# Les téléphones gardent les images et la police 30 jours ; la page elle-même est toujours revérifiée
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
